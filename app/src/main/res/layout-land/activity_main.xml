<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black" android:keepScreenOn="true">

    <SurfaceView android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="match_parent"/>

    <com.imaxcam.ui.ViewfinderOverlay android:id="@+id/viewfinder"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no"/>

    <View android:layout_width="match_parent" android:layout_height="140dp"
        android:layout_gravity="top" android:background="@drawable/bg_top_scrim"/>

    <LinearLayout android:id="@+id/topHud"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:orientation="vertical"
        android:paddingStart="25dp" android:paddingEnd="18dp" android:paddingTop="13dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/brand_title" android:textColor="@color/text_primary"
                    android:textStyle="bold" android:textSize="20sp" android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-black"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/brand_subtitle" android:textColor="@color/text_secondary"
                    android:textSize="8sp" android:letterSpacing="0.23"/>
            </LinearLayout>

            <TextView android:id="@+id/recordTimer"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp"
                android:background="@drawable/bg_hud" android:textColor="@color/record"
                android:textStyle="bold" android:fontFamily="monospace" android:textSize="12sp"
                android:layout_marginEnd="8dp" android:visibility="gone"/>

            <TextView android:id="@+id/hudMode"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:background="@drawable/bg_badge" android:textColor="@color/accent"
                android:textStyle="bold" android:textSize="11sp" android:layout_marginEnd="8dp"/>

            <ImageButton android:id="@+id/settingsButton"
                android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/bg_icon_button" android:src="@drawable/ic_tune"
                android:padding="10dp" android:contentDescription="@string/settings_open"
                android:scaleType="fitCenter"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/hudSize" style="@style/HudText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:layout_marginEnd="15dp"/>
            <TextView android:id="@+id/hudAudio" style="@style/HudText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxWidth="210dp" android:ellipsize="end" android:maxLines="1"
                android:textColor="@color/text_secondary" android:layout_marginEnd="14dp"/>
            <TextView android:id="@+id/hudLatency" style="@style/HudText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/captureDock"
        android:layout_width="128dp" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end" android:layout_marginEnd="16dp"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:background="@drawable/bg_panel" android:padding="9dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/capture_label" android:textColor="@color/text_secondary"
            android:textSize="9sp" android:letterSpacing="0.10" android:layout_marginTop="6dp"/>
        <Button android:id="@+id/recordButton"
            android:layout_width="78dp" android:layout_height="78dp"
            android:layout_marginTop="7dp" android:layout_marginBottom="7dp"
            android:background="@drawable/bg_record_button"
            android:minWidth="0dp" android:minHeight="0dp"
            android:contentDescription="@string/record_start"/>

        <TextView android:id="@+id/captureHint"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/capture_ready" android:textColor="@color/text_secondary"
            android:textSize="8sp" android:letterSpacing="0.06" android:layout_marginBottom="10dp"/>

        <Button android:id="@+id/qualityButton"
            android:layout_width="match_parent" android:layout_height="36dp"
            android:layout_marginBottom="6dp" android:background="@drawable/bg_chip"
            android:minWidth="0dp" android:minHeight="0dp"
            android:text="@string/quality_default" android:textAllCaps="false"
            android:textColor="@color/text_primary" android:textSize="10sp"/>

        <Button android:id="@+id/orientationButton"
            android:layout_width="match_parent" android:layout_height="36dp"
            android:layout_marginBottom="8dp" android:background="@drawable/bg_chip"
            android:minWidth="0dp" android:minHeight="0dp"
            android:text="@string/rotation_auto" android:textAllCaps="false"
            android:textColor="@color/text_primary" android:textSize="10sp"/>

        <ImageButton android:id="@+id/switchCamera"
            android:layout_width="42dp" android:layout_height="42dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_flip_camera" android:padding="9dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/switch_camera"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_marginEnd="160dp"
        android:background="@drawable/bg_bottom_scrim"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingBottom="15dp"
        android:paddingTop="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/ratio_title" android:textSize="9sp"
            android:textColor="@color/text_secondary" android:letterSpacing="0.15"
            android:layout_marginBottom="6dp"/>
        <HorizontalScrollView android:id="@+id/ratioScroller"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:id="@+id/ratioBar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"/>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/settingsPanel"
        android:layout_width="218dp" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="62dp"
        android:layout_marginEnd="18dp" android:orientation="vertical"
        android:background="@drawable/bg_panel" android:elevation="18dp"
        android:padding="15dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_title" android:textColor="@color/accent"
            android:textSize="11sp" android:letterSpacing="0.10"
            android:textStyle="bold" android:layout_marginBottom="7dp"/>
        <CheckBox android:id="@+id/lowLatency"
            android:layout_width="match_parent" android:layout_height="40dp"
            android:checked="true" android:buttonTint="@color/accent"
            android:text="@string/low_latency" android:textColor="@color/text_primary"
            android:textSize="12sp"/>
        <CheckBox android:id="@+id/stabilization"
            android:layout_width="match_parent" android:layout_height="40dp"
            android:buttonTint="@color/accent" android:text="@string/stabilization"
            android:textColor="@color/text_primary" android:textSize="12sp"/>
        <CheckBox android:id="@+id/spatialAudioAuto"
            android:layout_width="match_parent" android:layout_height="40dp"
            android:checked="true" android:buttonTint="@color/accent"
            android:text="@string/spatial_audio_auto" android:textColor="@color/text_primary"
            android:textSize="12sp"/>
        <CheckBox android:id="@+id/audioEnabled"
            android:layout_width="match_parent" android:layout_height="40dp"
            android:checked="true" android:buttonTint="@color/accent"
            android:text="@string/audio" android:textColor="@color/text_primary"
            android:textSize="12sp"/>
    </LinearLayout>
</FrameLayout>