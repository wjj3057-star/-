<?xml version="1.0" encoding="utf-8"?>
<!--
    Plain FrameLayout with gravity-positioned overlays. The preview fills the window and
    every control is an edge-anchored island, which is exactly what layout_gravity
    expresses; a constraint solver would have nothing to solve here.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Status read-out: dynamic range, output size and the measured capture latency. -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_hud"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/hudMode"
            style="@style/HudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hudSize"
            style="@style/HudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/hudLatency"
            style="@style/HudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/recordTimer"
        style="@style/HudText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_margin="16dp"
        android:background="@drawable/bg_hud"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:textColor="@color/record"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Aspect ratio picker, filled in from ImaxFormat at runtime. -->
    <LinearLayout
        android:id="@+id/ratioBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_margin="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/recordButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_record_button"
            android:contentDescription="@string/record_start" />

        <Button
            android:id="@+id/switchCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_chip"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/switch_camera"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/toggles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_hud"
        android:orientation="vertical"
        android:padding="8dp">

        <CheckBox
            android:id="@+id/lowLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/low_latency"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/stabilization"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stabilization"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/audioEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/audio"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
