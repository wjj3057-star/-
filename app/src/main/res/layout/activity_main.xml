<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status read-out: dynamic range, output size and the measured capture latency. -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_hud"
        android:padding="10dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/hudMode"
            style="@style/HudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:text="HDR10+" />

        <TextView
            android:id="@+id/hudSize"
            style="@style/HudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="--" />

        <TextView
            android:id="@+id/hudLatency"
            style="@style/HudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="--" />
    </LinearLayout>

    <TextView
        android:id="@+id/recordTimer"
        style="@style/HudText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_hud"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/record"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="00:00"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Aspect ratio picker -->
    <LinearLayout
        android:id="@+id/ratioBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Right-hand controls -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/recordButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_record_button"
            android:contentDescription="@string/record_start" />

        <Button
            android:id="@+id/switchCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="14dp"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:text="@string/switch_camera" />
    </LinearLayout>

    <!-- Toggles -->
    <LinearLayout
        android:id="@+id/toggles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_hud"
        android:padding="8dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <CheckBox
            android:id="@+id/lowLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            android:text="@string/low_latency" />

        <CheckBox
            android:id="@+id/stabilization"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            android:text="@string/stabilization" />

        <CheckBox
            android:id="@+id/audioEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            android:text="@string/audio" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
