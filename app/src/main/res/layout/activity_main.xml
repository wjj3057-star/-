<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black" android:keepScreenOn="true">

    <SurfaceView android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="match_parent"/>

    <com.imaxcam.ui.ViewfinderOverlay android:id="@+id/viewfinder"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no"/>

    <View android:layout_width="match_parent" android:layout_height="210dp"
        android:layout_gravity="top" android:background="@drawable/bg_top_scrim"/>

    <LinearLayout android:id="@+id/topHud"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:orientation="vertical"
        android:paddingLeft="20dp" android:paddingRight="18dp"
        android:paddingTop="15dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/brand_title" android:textColor="@color/text_primary"
                    android:textStyle="bold" android:textSize="22sp" android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-black"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/brand_subtitle" android:textColor="@color/text_secondary"
                    android:textSize="9sp" android:letterSpacing="0.23"/>
            </LinearLayout>

            <TextView android:id="@+id/recordTimer"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp"
                android:background="@drawable/bg_hud" android:textColor="@color/record"
                android:textStyle="bold" android:fontFamily="monospace" android:textSize="12sp"
                android:layout_marginEnd="8dp" android:visibility="gone"/>

            <TextView android:id="@+id/hudMode"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:gravity="center" android:paddingStart="13dp" android:paddingEnd="13dp"
                android:background="@drawable/bg_badge" android:textColor="@color/accent"
                android:textStyle="bold" android:textSize="11sp" android:layout_marginEnd="8dp"/>

            <ImageButton android:id="@+id/settingsButton"
                android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/bg_icon_button" android:src="@drawable/ic_tune"
                android:padding="10dp" android:contentDescription="@string/settings_open"
                android:scaleType="fitCenter"/>
        </LinearLayout>

        <TextView android:id="@+id/hudSize" style="@style/HudText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/text_primary"
            android:textSize="12sp" android:letterSpacing="0.045"/>

        <TextView android:id="@+id/hudAudio" style="@style/HudText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:maxLines="1"
            android:ellipsize="end" android:textColor="@color/text_secondary"/>

        <TextView android:id="@+id/hudLatency" style="@style/HudText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="@color/text_secondary"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/captureDock"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:gravity="center_horizontal" android:background="@drawable/bg_bottom_scrim"
        android:paddingTop="38dp" android:paddingBottom="21dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="23dp" android:layout_marginBottom="9dp"
            android:text="@string/ratio_title" android:textColor="@color/text_secondary"
            android:textSize="10sp" android:letterSpacing="0.17"
            android:fontFamily="sans-serif-medium"/>

        <HorizontalScrollView android:id="@+id/ratioScroller"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fillViewport="true" android:scrollbars="none"
            android:paddingStart="16dp" android:paddingEnd="8dp"
            android:clipToPadding="false">
            <LinearLayout android:id="@+id/ratioBar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center"/>
        </HorizontalScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp" android:gravity="center"
            android:orientation="horizontal">
            <Button android:id="@+id/orientationButton"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="42dp" android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip" android:minWidth="0dp"
                android:minHeight="0dp" android:text="@string/rotation_auto"
                android:textAllCaps="false" android:textColor="@color/text_primary"
                android:textSize="11sp" android:fontFamily="sans-serif-medium"/>
            <Button android:id="@+id/qualityButton"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="42dp" android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip" android:minWidth="0dp"
                android:minHeight="0dp" android:text="@string/quality_default"
                android:textAllCaps="false" android:textColor="@color/text_primary"
                android:textSize="11sp" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="94dp"
            android:layout_marginTop="13dp" android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp">

            <Button android:id="@+id/recordButton"
                android:layout_width="84dp" android:layout_height="84dp"
                android:layout_gravity="center" android:background="@drawable/bg_record_button"
                android:minWidth="0dp" android:minHeight="0dp"
                android:contentDescription="@string/record_start"/>

            <ImageButton android:id="@+id/switchCamera"
                android:layout_width="52dp" android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_icon_button"
                android:src="@drawable/ic_flip_camera"
                android:padding="10dp" android:scaleType="fitCenter"
                android:contentDescription="@string/switch_camera"/>
        </FrameLayout>

        <TextView android:id="@+id/captureHint"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/capture_ready" android:letterSpacing="0.20"
            android:textSize="10sp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_secondary"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/settingsPanel"
        android:layout_width="218dp" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="69dp"
        android:layout_marginEnd="15dp" android:orientation="vertical"
        android:background="@drawable/bg_panel" android:elevation="18dp"
        android:padding="15dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_title" android:textColor="@color/accent"
            android:textSize="11sp" android:letterSpacing="0.10"
            android:textStyle="bold" android:layout_marginBottom="7dp"/>
        <CheckBox android:id="@+id/lowLatency"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:checked="true" android:buttonTint="@color/accent"
            android:text="@string/low_latency" android:textColor="@color/text_primary"
            android:textSize="12sp"/>
        <CheckBox android:id="@+id/stabilization"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:buttonTint="@color/accent" android:text="@string/stabilization"
            android:textColor="@color/text_primary" android:textSize="12sp"/>
        <CheckBox android:id="@+id/spatialAudioAuto"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:checked="true" android:buttonTint="@color/accent"
            android:text="@string/spatial_audio_auto" android:textColor="@color/text_primary"
            android:textSize="12sp"/>
        <CheckBox android:id="@+id/audioEnabled"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:checked="true" android:buttonTint="@color/accent"
            android:text="@string/audio" android:textColor="@color/text_primary"
            android:textSize="12sp"/>
    </LinearLayout>
</FrameLayout>